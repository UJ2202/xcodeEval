        "source_code": "fun main(){\n    readLine()!!\n    val s = readLine()!!\n\n    var d = 0\n    for (c in s){\n        if (c=='+'){\n            d++\n        }else{\n            if (d==0) d=1\n            d--\n        }\n\n    }\n    println(d)\n}",
