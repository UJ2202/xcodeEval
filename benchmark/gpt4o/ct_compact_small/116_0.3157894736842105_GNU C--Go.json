        "prompt": "Here is code in GNU C programming lanaguge. Translate the following code from GNU C to Go programming lanaguge. Do not output any extra description or tokens other than the translated code. \n\n#include<stdio.h>\nint main()\n{\n    long long n,a,b,c,i,j,k,diff,min=10000000000,max;\n    scanf(\"%lld\",&n);\n    for(i=1;i*i*i<=n;i++)\n    {\n        if(n%i==0)\n        {\n            for(j=i;j*j<=n/i;j++)\n            {\n                if(n%j==0)\n                k=n/(i*j);\n                a=i+1;b=j+2;c=k+2;\n                if((a-1)*(b-2)*(c-2)==n)\n                diff=(a*b*c)-n;\n                if(min>diff)\n                min=diff;\n                \n        }\n        }\n    }\n    max=9*(n+1)-n;\n    printf(\"%lld %lld\",min,max);\n    return 0;\n}"
