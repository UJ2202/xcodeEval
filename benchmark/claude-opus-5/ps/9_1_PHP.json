                    "content": "```php\n<?php\nfunction pw($b, $e, $M) {\n    $r = 1;\n    $b %= $M;\n    while ($e > 0) {\n        if ($e & 1) $r = $r * $b % $M;\n        $b = $b * $b % $M;\n        $e >>= 1;\n    }\n    return $r;\n}\n\n$line = trim(fgets(STDIN));\n$parts = preg_split('/\\s+/', $line);\n$n = (int)$parts[0];\n$k = (int)$parts[1];\n$M = 1000000007;\n\n$fac = array();\nforeach (array(2, 3) as $p) {\n    while ($n % $p == 0) {\n        $n = intdiv($n, $p);\n        if (!isset($fac[$p])) $fac[$p] = 0;\n        $fac[$p]++;\n    }\n}\n$p = 5;\n$step = 2;\nwhile ($p * $p <= $n) {\n    if ($n % $p == 0) {\n        while ($n % $p == 0) {\n            $n = intdiv($n, $p);\n            if (!isset($fac[$p])) $fac[$p] = 0;\n            $fac[$p]++;\n        }\n    }\n    $p += $step;\n    $step = 6 - $step;\n}\nif ($n > 1) {\n    if (!isset($fac[$n])) $fac[$n] = 0;\n    $fac[$n]++;\n}\n\n$ans = 1;\nforeach ($fac as $prime => $e) {\n    $inv = array_fill(0, $e + 2, 0);\n    for ($i = 1; $i <= $e + 1; $i++) $inv[$i] = pw($i, $M - 2, $M);\n    $dp = array_fill(0, $e + 1, 0);\n    $dp[$e] = 1;\n    for ($t = 0; $t < $k; $t++) {\n        $nd = array_fill(0, $e + 1, 0);\n        $s = 0;\n        for ($i = $e; $i >= 0; $i--) {\n            $s = ($s + $dp[$i] * $inv[$i + 1]) % $M;\n            $nd[$i] = $s;\n        }\n        $dp = $nd;\n    }\n    $pm = $prime % $M;\n    $cur = 1;\n    $tot = 0;\n    for ($j = 0; $j <= $e; $j++) {\n        $tot = ($tot + $dp[$j] * $cur) % $M;\n        $cur = $cur * $pm % $M;\n    }\n    $ans = $ans * $tot % $M;\n}\necho $ans, \"\\n\";\n```",
