m, minP)\n        if key in memo:\n            return memo[key]\n        t = 0\n        for d in cand_keys:\n            if d > m:\n                break\n            if m % d == 0:\n                for p in cand[d]:\n                    if p >= minP:\n                        t += rec(m // d, p + 1)\n        memo[key] = t\n        return t\n\n    print(rec(A, 2))\n\nmain()\n```",
