                    "content": "```php\n<?php\n$n = intval(trim(fgets(STDIN)));\n$s = trim(fgets(STDIN));\n$m = strlen($s);\n\n// prefix function\n$pi = array_fill(0, $m, 0);\nfor ($i = 1; $i < $m; $i++) {\n    $j = $pi[$i-1];\n    while ($j > 0 && $s[$i] !== $s[$j]) $j = $pi[$j-1];\n    if ($s[$i] === $s[$j]) $j++;\n    $pi[$i] = $j;\n}\n\n// automaton delta for states 0..m-1\n$delta = array();\nfor ($q = 0; $q < $m; $q++) {\n    $delta[$q] = array();\n    foreach (array('0','1') as $c) {\n        if ($s[$q] === $c) {\n            $delta[$q][$c] = $q + 1;\n        } else {\n            if ($q == 0) $delta[$q][$c] = 0;\n            else $delta[$q][$c] = $delta[$pi[$q-1]][$c];\n        }\n    }\n}\n\n// transition matrix excluding accepting state\n$M = array();\nfor ($i = 0; $i < $m; $i++) {\n    $M[$i] = array_fill(0, $m, 0);\n}\nfor ($q = 0; $q < $m; $q++) {\n    foreach (array('0','1') as $c) {\n        $r = $delta[$q][$c];\n        if ($r < $m) {\n            $M[$q][$r] += 1;\n        }\n    }\n}\n\nfunction matmul($A, $B, $m) {\n    $C = array();\n    for ($i = 0; $i < $m; $i++) {\n        $C[$i] = array_fill(0, $m, 0);\n    }\n    for ($i = 0; $i < $m; $i++) {\n        for ($k = 0; $k < $m; $k++) {\n            $a = $A[$i][$k];\n            if ($a == 0) continue;\n            for ($j = 0; $j < $m; $j++) {\n                if ($B[$k][$j] != 0) {\n                    $C[$i][$j] += $a * $B[$k][$j];\n                }\n            }\n        }\n    }\n    return $C;\n}\n\n// identity\n$R = array();\nfor ($i = 0; $i < $m; $i++) {\n    $R[$i] = array_fill(0, $m, 0);\n    $R[$i][$i] = 1;\n}\n$base = $M;\n$e = $n;\nwhile ($e > 0) {\n    if ($e & 1) $R = matmul($R, $base, $m);\n    $e >>= 1;\n    if ($e > 0) $base = matmul($base, $base, $m);\n}\n\n$trace = 0;\nfor ($i = 0; $i < $m; $i++) $trace += $R[$i][$i];\n\n$total = 1;\nfor ($i = 0; $i < $n; $i++) $total *= 2;\n\necho ($total - $trace), \"\\n\";\n?>\n```",
