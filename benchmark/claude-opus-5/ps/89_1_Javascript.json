                    "content": "```javascript\nconst data = require('fs').readFileSync(0, 'utf8').split(/\\s+/).filter(s=>s.length>0);\nconst n = parseInt(data[0]), m = parseInt(data[1]);\nconst rows = Math.min(n,m), cols = Math.max(n,m);\nconst full = (1<<rows)-1;\nconst size = 1<<rows;\nfunction cover(mask){ return (mask | (mask<<1) | (mask>>1)) & full; }\nfunction pc(x){ let c=0; while(x){ c += x&1; x >>= 1; } return c; }\nconst INF = 1e9;\nconst coverArr = new Array(size);\nconst pcArr = new Array(size);\nfor(let i=0;i<size;i++){ coverArr[i]=cover(i); pcArr[i]=pc(i); }\n\nlet dp = [];\nfor(let i=0;i<size;i++){ dp.push(new Int32Array(size).fill(INF)); }\nfor(let cur=0;cur<size;cur++){\n  const cv = coverArr[cur];\n  if(pcArr[cur] < dp[cur][cv]) dp[cur][cv] = pcArr[cur];\n}\n\nfor(let col=1; col<cols; col++){\n  const ndp = [];\n  for(let i=0;i<size;i++){ ndp.push(new Int32Array(size).fill(INF)); }\n  for(let cur=0;cur<size;cur++){\n    const row = dp[cur];\n    for(let cov=0;cov<size;cov++){\n      const v = row[cov];\n      if(v>=INF) continue;\n      for(let next=0;next<size;next++){\n        if(((cov|next)&full) !== full) continue;\n        const nc = (coverArr[next] | cur) & full;\n        const nv = v + pcArr[next];\n        if(nv < ndp[next][nc]) ndp[next][nc] = nv;\n      }\n    }\n  }\n  dp = ndp;\n}\n\nlet best = INF;\nfor(let cur=0;cur<size;cur++){\n  if(dp[cur][full] < best) best = dp[cur][full];\n}\nconsole.log(String(n*m - best));\n```",
