                    "content": "```javascript\nconst data = require('fs').readFileSync(0, 'utf8').split('\\n');\nconst n = parseInt(data[0].trim());\nconst s = data[1].trim();\nconst m = s.length;\n\n// prefix function\nconst pi = new Array(m).fill(0);\nfor (let i = 1; i < m; i++) {\n    let j = pi[i-1];\n    while (j > 0 && s[i] !== s[j]) j = pi[j-1];\n    if (s[i] === s[j]) j++;\n    pi[i] = j;\n}\n\n// automaton transitions for states 0..m-1\nconst trans = [];\nfor (let st = 0; st < m; st++) {\n    trans.push([0,0]);\n    for (let c = 0; c < 2; c++) {\n        const ch = c === 0 ? '0' : '1';\n        if (s[st] === ch) {\n            trans[st][c] = st + 1;\n        } else if (st === 0) {\n            trans[st][c] = 0;\n        } else {\n            trans[st][c] = trans[pi[st-1]][c];\n        }\n    }\n}\n\nlet total = 0n;\nfor (let start = 0; start < m; start++) {\n    let dp = new Array(m).fill(0n);\n    dp[start] = 1n;\n    for (let step = 0; step < n; step++) {\n        const nd = new Array(m).fill(0n);\n        for (let st = 0; st < m; st++) {\n            if (dp[st] === 0n) continue;\n            for (let c = 0; c < 2; c++) {\n                const to = trans[st][c];\n                if (to === m) continue;\n                nd[to] += dp[st];\n            }\n        }\n        dp = nd;\n    }\n    total += dp[start];\n}\n\nconst totalStrings = 1n << BigInt(n);\nconsole.log((totalStrings - total).toString());\n```",
