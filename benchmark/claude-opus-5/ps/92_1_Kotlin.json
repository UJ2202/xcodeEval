                    "content": "```kotlin\nimport java.io.DataInputStream\n\nclass FastReader(stream: java.io.InputStream) {\n    private val BUFSZ = 1 shl 16\n    private val din = DataInputStream(stream)\n    private val buffer = ByteArray(BUFSZ)\n    private var bufferPointer = 0\n    private var bytesRead = 0\n\n    private fun read(): Byte {\n        if (bufferPointer == bytesRead) fillBuffer()\n        return buffer[bufferPointer++]\n    }\n\n    private fun fillBuffer() {\n        bytesRead = din.read(buffer, 0, BUFSZ)\n        bufferPointer = 0\n        if (bytesRead == -1) { bytesRead = 0; buffer[0] = -1 }\n    }\n\n    fun nextInt(): Int {\n        var ret = 0\n        var b = read()\n        while (b <= ' '.code.toByte()) b = read()\n        val neg = b == '-'.code.toByte()\n        if (neg) b = read()\n        while (b >= '0'.code.toByte() && b <= '9'.code.toByte()) {\n            ret = ret * 10 + (b - '0'.code.toByte())\n            b = read()\n        }\n        return if (neg) -ret else ret\n    }\n}\n\nfun main() {\n    val fr = FastReader(System.`in`)\n    val n = fr.nextInt()\n    val m = fr.nextInt()\n    val f = IntArray(n + 1)\n    for (i in 1..n) f[i] = fr.nextInt()\n    val ea = IntArray(m)\n    val eb = IntArray(m)\n    val outDeg = IntArray(n + 2)\n    val inDeg = IntArray(n + 2)\n    for (i in 0 until m) {\n        val a = fr.nextInt()\n        val b = fr.nextInt()\n        ea[i] = a; eb[i] = b\n        outDeg[a]++\n        inDeg[b]++\n    }\n    val fStart = IntArray(n + 2)\n    val rStart = IntArray(n + 2)\n    for (i in 1..n) {\n        fStart[i + 1] = fStart[i] + outDeg[i]\n        rStart[i + 1] = rStart[i] + inDeg[i]\n    }\n    val fPos = IntArray(n + 2)\n    val rPos = IntArray(n + 2)\n    for (i in 1..n + 1) { fPos[i] = fStart[i]; rPos[i] = rStart[i] }\n    val fAdj = IntArray(m)\n    val rAdj = IntArray(m)\n    for (i in 0 until m) {\n        fAdj[fPos[ea[i]]++] = eb[i]\n        rAdj[rPos[eb[i]]++] = ea[i]\n    }\n\n    val A = BooleanArray(n + 1)\n    val B = BooleanArray(n + 1)\n    val queue = IntArray(n + 1)\n\n    var head = 0\n    var tail = 0\n    for (i in 1..n) if (f[i] == 1) { A[i] = true; queue[tail++] = i }\n    while (head < tail) {\n        val u = queue[head++]\n        var j = fStart[u]\n        val end = fStart[u + 1]\n        while (j < end) {\n            val w = fAdj[j]\n            if (!A[w] && f[w] != 1) { A[w] = true; queue[tail++] = w }\n            j++\n        }\n    }\n\n    head = 0; tail = 0\n    for (i in 1..n) if (f[i] == 2) { B[i] = true; queue[tail++] = i }\n    while (head < tail) {\n        val v = queue[head++]\n        if (f[v] == 1) continue\n        var j = rStart[v]\n        val end = rStart[v + 1]\n        while (j < end) {\n            val u = rAdj[j]\n            if (!B[u]) { B[u] = true; queue[tail++] = u }\n            j++\n        }\n    }\n\n    val sb = StringBuilder()\n    for (i in 1..n) {\n        sb.append(if (A[i] && B[i]) '1' else '0')\n        sb.append('\\n')\n    }\n    print(sb)\n}\n```",
