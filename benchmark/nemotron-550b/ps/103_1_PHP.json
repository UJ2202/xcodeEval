=== \"@\") return false;\n    \n    // Only allowed characters: lowercase letters, ., @\n    for ($i = 0; $i < strlen($str); $i++) {\n        $c = $str[$i];\n        if (!($c >= 'a' && $c <= 'z') && $c !== '.' && $c !== '@') {\n            return false;\n        }\n    }\n    \n    return true;\n}\n\nfunction isBetter($a, $b) {\n    if (strlen($a) !== strlen($b)) {\n        return strlen($a) < strlen($b);\n    }\n    return $a < $b;\n}\n\nsolve();\n?>", "role": "assistant", "provider_specific_fields": {"refusal": null, "reasoning": null}}, "provider_specific_fields": {"stop_reason": null, "token_ids": null, "routed_experts": null}}], "usage": {"completion_tokens": 701, "prompt_tokens": 452, "total_tokens": 1153}}, "source_data": {"prob_desc_input_from": "standard input", "lang": "PHP", "src_uid": "a11c9679d8e2dca51be17d466202df6e", "difficulty": 1300, "prob_desc_sample_inputs": "[\"vasyaatgmaildotcom\", \"dotdotdotatdotdotat\", \"aatt\"]", "prob_desc_time_limit": "2 seconds", "tags": ["expression parsing", "implementation"], "prob_desc_output_spec": "Print the shortest email address, from which the given line could be made by the described above replacements. If there are several solutions to that problem, print the lexicographically minimal one (the lexicographical comparison of the lines are implemented with an operator &lt; in modern programming languages). In the ASCII table the symbols go in this order: . @ ab...z", "prob_desc_input_spec": "The first line contains the email address description. It is guaranteed that that is a proper email address with all the dots replaced by dot an the at signs replaced by at. The line is not empty and its length does not exceed 100 symbols.", "lang_cluster": "PHP", "source_code": "", "prob_desc_notes": null, "prob_desc_memory_limit": "256 megabytes", "file_name": "f4ed0b00bb6e7ee08ac776c854815632126f0d5842ed19563ab75f1660d87635", "code_uid": "", "prob_desc_description": "Sometimes one has to spell email addresses over the pho