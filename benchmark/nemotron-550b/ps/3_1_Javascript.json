   const nextStr = pre + ch;\n        let nextStateStr = \"\";\n        if (wordSet.has(nextStr)) {\n            nextStateStr = \"\";\n        } else {\n            let found = false;\n            for (let l = 1; l <= nextStr.length; l++) {\n                const suf = nextStr.substring(nextStr.length - l);\n                if (prefixesSet.has(suf)) {\n                    nextStateStr = suf;\n                    found = true;\n                    break;\n                }\n            }\n            if (!found) continue; // dead transition\n        }\n        const j = prefixToId[nextStateStr];\n        trans[i][j] = (trans[i][j] + 1) % MOD;\n    }\n}\n\n// Build product automaton matrix\nconst S = P * P;\nconst M = Array(S).fill(0).map(() => Array(S).fill(0));\nfor (let i1 = 0; i1 < P; i1++) {\n    for (let i2 = 0; i2 < P; i2++) {\n        const fromIdx = i1 * P + i2;\n        for (let j1 = 0; j1 < P; j1++) {\n            const cnt1 = trans[i1][j1];\n            if (cnt1 === 0) continue;\n            for (let j2 = 0; j2 < P; j2++) {\n                const cnt2 = trans[i2][j2];\n                if (cnt2 === 0) continue;\n                const toIdx = j1 * P + j2;\n                M[fromIdx][toIdx] = (M[fromIdx][toIdx] + cnt1 * cnt2) % MOD;\n            }\n        }\n    }\n}\n\nconst startIdx = prefixToId[\"\"] * P + prefixToId[\"\"];\nconst Mpow = matPow(M, m);\nconsole.log(Mpow[startIdx][startIdx] % MOD);\n```", "role": "assistant", "provider_specific_fields": {"refusal": null, "reasoning": null}}, "provider_specific_fields": {"stop_reason": null, "token_ids": null, "routed_experts": null}}], "usage": {"completion_tokens": 961, "prompt_tokens": 691, "total_tokens": 1652}}, "source_data": {"prob_desc_input_from": "standard input", "lang": "Javascript", "src_uid": "711d15e11016d0164fb2b0c3756e4857", "difficulty": 2700, "prob_desc_sample_inputs": "[\"3 5\\nababa\\nab\\na\", \"2 4\\nab\\ncd\", \"5 100\\na\\naa\\naaa\\naaaa\\naaaaa\"]", "prob_desc_time_limit": "3 secon