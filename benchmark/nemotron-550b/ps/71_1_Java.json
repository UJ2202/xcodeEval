{"oai_response": {"id": "chatcmpl-8f9a805616ae74df", "created": 1787266037, "model": "nvidia/nemotron-3-ultra-550b-a55b", "object": "chat.completion", "system_fingerprint": "vllm-0.26.0-tp8-6b7faac2", "choices": [{"finish_reason": "stop", "index": 0, "message": {"content": "```java\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev, cap, cost;\n        Edge(int to, int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int N;\n        List<List<Edge>> graph;\n        MinCostMaxFlow(int N) {\n            this.N = N;\n            graph = new ArrayList<>(N);\n            for (int i = 0; i < N; i++) graph.add(new ArrayList<>());\n        }\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, graph.get(t).size(), cap, cost);\n            Edge b = new Edge(s, graph.get(s).size(), 0, -cost);\n            graph.get(s).add(a);\n            graph.get(t).add(b);\n        }\n\n        // Returns pair (flow, cost)\n        Pair<Integer, Integer> minCostFlow(int s, int t, int maxf) {\n            int flow = 0;\n            int cost = 0;\n            int[] dist = new int[N];\n            int[] pv = new int[N];\n            int[] pe = new int[N];\n            boolean[] inqueue = new boolean[N];\n            while (flow < maxf) {\n                Arrays.fill(dist, Integer.MAX_VALUE);\n                dist[s] = 0;\n                Queue<Integer> q = new ArrayDeque<>();\n                q.add(s);\n                inqueue[s] = true;\n                while (!q.isEmpty()) {\n                    int v = q.poll();\n                    inqueue[v] = false;\n                    for (int i = 0; i < graph.get(v).size(); i++) {\n                        Edge e = graph.get(v).get(i);\n                        if (e.cap > 0 && dist[v] != Integer.MAX_VALUE && dist[v] + e.cost < dist[e.to]) {\n                            dist[e.to] = dist[v] + e.cost;\n                            pv[e.to] = v;\n                            pe[e.to] = i;\n                            if (!inqueue[e.to]) {\n                                inqueue[e.to] = true;\n                                q.add(e.to);\n                            }\n                        }\n                    }\n                }\n                if (dist[t] == Integer.MAX_VALUE) break;\n                int addf = maxf - flow;\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = graph.get(pv[v]).get(pe[v]);\n                    addf = Math.min(addf, e.cap);\n                }\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = graph.get(pv[v]).get(pe[v]);\n                    e.cap -= addf;\n                    graph.get(v).get(e.rev).cap += addf;\n                }\n                flow += addf;\n                cost += addf * dist[t];\n            }\n            return new Pair<>(flow, cost);\n        }\n    }\n\n    static class Pair<A, B> {\n        A first; B second;\n        Pair(A a, B b) { first = a; second = b; }\n    }\n\n    public static void main(String[] args) {\n        FastScanner fs = new FastScanner();\n        int n = fs.nextInt();\n        int m = fs.nextInt();\n        int[][] a = new int[n][m];\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < m; j++)\n                a[i][j] = fs.nextInt();\n\n        // Bipartite matching: cells with (i+j)%2==0 -> left, else right\n        int V = n * m;\n        int source = V;\n        int sink = V + 1;\n        MinCostMaxFlow mcmf = new MinCostMaxFlow(V + 2);\n\n        int[] dx = {1, -1, 0, 0};\n        int[] dy = {0, 0, 1, -1};\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                int id = i * m + j;\n                if ((i + j) % 2 == 0) {\n                    mcmf.addEdge(source, id, 1, 0);\n                    for (int dir = 0; dir < 4; dir++) {\n                        int ni = i + dx[dir];\n                        int nj = j + dy[dir];\n                        if (ni >= 0 && ni < n && nj >= 0 && nj < m) {\n                            int nid = ni * m + nj;\n                            int cost = (a[i][j] == a[ni][nj]) ? 0 : 1;\n                            mcmf.addEdge(id, nid, 1, cost);\n                        }\n                    }\n                } else {\n                    mcmf.addEdge(id, sink, 1, 0);\n                }\n            }\n        }\n\n        int maxPairs = n * m / 2;\n        Pair<Integer, Integer> result = mcmf.minCostFlow(source, sink, maxPairs);\n        // result.second is the minimum number of mismatched pairs = number of shoes to move\n        System.out.println(result.second);\n    }\n\n    static class FastScanner {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(\"\");\n        String next() {\n            while (!st.hasMoreTokens())\n                try { st = new StringTokenizer(br.readLine()); } catch (IOException e) { e.printStackTrace(); }\n            return st.nextToken();\n        }\n        int nextInt() { return Integer.parseInt(next()); }\n    }\n}\n```", "role": "assistant", "provider_specific_fields": {"refusal": null, "reasoning": null}}, "provider_specific_fields": {"stop_reason": null, "token_ids": null, "routed_experts": null}}], "usage": {"completion_tokens": 1237, "prompt_tokens": 697, "total_tokens": 1934}}, "source_data": {"prob_desc_input_from": "standard input", "lang": "Java", "src_uid": "1f0e8bbd5bf4fcdea927fbb505a8949b", "difficulty": 2200, "prob_desc_sample_inputs": "[\"2 3\\n1 1 2\\n2 3 3\", \"3 4\\n1 3 2 6\\n2 1 5 6\\n4 4 5 3\"]", "prob_desc_time_limit": "4 seconds", "tags": ["flows"], "prob_desc_output_spec": "Print exactly one integer \u2014 the minimum number of the sneakers that n