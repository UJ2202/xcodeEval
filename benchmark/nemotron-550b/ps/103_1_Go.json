; at++ {\n\t\tif at == 1 {\n\t\t\ts := dp[n][at]\n\t\t\tif len(s) > 0 && s[0] != rune(INF) && isValidEmail(s) {\n\t\t\t\tif best == \"\" || better(s, best) {\n\t\t\t\t\tbest = s\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tfmt.Println(best)\n}\n\nfunc better(a, b string) bool {\n\tif len(a) != len(b) {\n\t\treturn len(a) < len(b)\n\t}\n\treturn a < b\n}\n\nfunc isValidEmail(s string) bool {\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tif s[0] == '.' || s[0] == '@' {\n\t\treturn false\n\t}\n\tif s[len(s)-1] == '.' || s[len(s)-1] == '@' {\n\t\treturn false\n\t}\n\tatCount := 0\n\tfor _, c := range s {\n\t\tif c == '@' {\n\t\t\tatCount++\n\t\t} else if c != '.' && (c < 'a' || c > 'z') {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn atCount == 1\n}\n```", "role": "assistant", "provider_specific_fields": {"refusal": null, "reasoning": null}}, "provider_specific_fields": {"stop_reason": null, "token_ids": null, "routed_experts": null}}], "usage": {"completion_tokens": 853, "prompt_tokens": 452, "total_tokens": 1305}}, "source_data": {"prob_desc_input_from": "standard input", "lang": "Go", "src_uid": "a11c9679d8e2dca51be17d466202df6e", "difficulty": 1300, "prob_desc_sample_inputs": "[\"vasyaatgmaildotcom\", \"dotdotdotatdotdotat\", \"aatt\"]", "prob_desc_time_limit": "2 seconds", "tags": ["expression parsing", "implementation"], "prob_desc_output_spec": "Print the shortest email address, from which the given line could be made by the described above replacements. If there are several solutions to that problem, print the lexicographically minimal one (the lexicographical comparison of the lines are implemented with an operator &lt; in modern programming languages). In the ASCII table the symbols go in this order: . @ ab...z", "prob_desc_input_spec": "The first line contains the email address description. It is guaranteed that that is a proper email address with all the dots replaced by dot an the at signs replaced by at. The line is not empty and its length does not exceed 100 symbols