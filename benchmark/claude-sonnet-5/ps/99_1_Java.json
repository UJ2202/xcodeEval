                    "content": "```java\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int t = scanner.nextInt();\n\n        int PZ = t + 1;      // peaks can be 0..t\n        int VZ = t;          // valleys can be 0..t-1, if t-1 could be 0 => size at least 1\n        if (VZ < 1) VZ = 1;\n\n        // dp[pos][y][dirIn][peaks][valleys]\n        // dirIn: 0 = none (only at pos=1), 1 = up (last step was upward), 2 = down (last step was downward)\n        long[][][][][] dp = new long[n + 1][5][3][PZ][VZ];\n\n        // initialize pos = 1\n        for (int y = 1; y <= 4; y++) {\n            dp[1][y][0][0][0] = 1;\n        }\n\n        for (int pos = 1; pos < n; pos++) {\n            for (int y = 1; y <= 4; y++) {\n                for (int dirIn = 0; dirIn < 3; dirIn++) {\n                    for (int p = 0; p < PZ; p++) {\n                        for (int v = 0; v < VZ; v++) {\n                            long cur = dp[pos][y][dirIn][p][v];\n                            if (cur == 0) continue;\n\n                            for (int y2 = 1; y2 <= 4; y2++) {\n                                if (y2 == y) continue; // no horizontal segment\n                                int dirOut = (y2 > y) ? 1 : 2; // 1 = up, 2 = down\n\n                                int newP = p;\n                                int newV = v;\n                                boolean valid = true;\n\n                                if (dirIn != 0) {\n                                    // we have a previous direction, check for peak/valley at 'pos'\n                                    if (dirIn == 1 && dirOut == 2) {\n                                        // up then down => peak\n                                        newP = p + 1;\n                                        if (newP >= PZ) valid = false;\n                                    } else if (dirIn == 2 && dirOut == 1) {\n                                        // down then up => valley\n                                        newV = v + 1;\n                                        if (newV >= VZ) valid = false;\n                                    }\n                                    // else same direction continues, no change\n                                }\n\n                                if (!valid) continue;\n\n                                dp[pos + 1][y2][dirOut][newP][newV] += cur;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        long answer = 0;\n        int targetPeaks = t;\n        int targetValleys = t - 1;\n        if (targetValleys < 0) targetValleys = 0; // shouldn't happen since t>=1\n\n        for (int y = 1; y <= 4; y++) {\n            for (int dirIn = 1; dirIn < 3; dirIn++) { // dirIn can't be 0 at pos=n since n>=3 (at least one step happened)\n                if (targetPeaks < PZ && targetValleys < VZ) {\n                    answer += dp[n][y][dirIn][targetPeaks][targetValleys];\n                }\n            }\n        }\n\n        System.out.println(answer);\n    }\n}\n```",
