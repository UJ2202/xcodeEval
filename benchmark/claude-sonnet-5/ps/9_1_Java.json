                    "content": "```java\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final long MOD = 1_000_000_007L;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        long n = Long.parseLong(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n\n        Map<Long, Integer> factors = factorize(n);\n\n        long result = 1L;\n\n        for (Map.Entry<Long, Integer> entry : factors.entrySet()) {\n            long p = entry.getKey();\n            int e = entry.getValue();\n\n            // dp[a] = probability (mod) of being at exponent a\n            long[] dp = new long[e + 1];\n            dp[e] = 1L;\n\n            // precompute inverse of denominators 1..e+1\n            long[] invDenom = new long[e + 2];\n            for (int d = 1; d <= e + 1; d++) {\n                invDenom[d] = modpow(d, MOD - 2, MOD);\n            }\n\n            long[] arr = new long[e + 1];\n            long[] suf = new long[e + 1];\n\n            for (int step = 0; step < k; step++) {\n                for (int a = 0; a <= e; a++) {\n                    long denomInv = invDenom[a + 1];\n                    arr[a] = (dp[a] * denomInv) % MOD;\n                }\n                suf[e] = arr[e];\n                for (int a = e - 1; a >= 0; a--) {\n                    suf[a] = (suf[a + 1] + arr[a]) % MOD;\n                }\n                // new dp[b] = suf[b]\n                for (int b = 0; b <= e; b++) {\n                    dp[b] = suf[b];\n                }\n            }\n\n            // compute sum_{s=0}^{e} dp[s] * p^s mod MOD\n            long sum = 0L;\n            long pPow = 1L % MOD;\n            long pMod = p % MOD;\n            for (int s = 0; s <= e; s++) {\n                sum = (sum + dp[s] * pPow) % MOD;\n                pPow = (pPow * pMod) % MOD;\n            }\n\n            result = (result * sum) % MOD;\n        }\n\n        System.out.println(result % MOD);\n    }\n\n    static Map<Long, Integer> factorize(long n) {\n        Map<Long, Integer> factors = new LinkedHashMap<>();\n        long num = n;\n        for (long p = 2; p * p <= num; p++) {\n            if (num % p == 0) {\n                int cnt = 0;\n                while (num % p == 0) {\n                    num /= p;\n                    cnt++;\n                }\n                factors.put(p, cnt);\n            }\n        }\n        if (num > 1) {\n            factors.put(num, factors.getOrDefault(num, 0) + 1);\n        }\n        return factors;\n    }\n\n    static long modpow(long base, long exp, long mod) {\n        base %= mod;\n        if (base < 0) base += mod;\n        long result = 1L;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n```",
