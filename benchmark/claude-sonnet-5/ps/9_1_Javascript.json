                    "content": "```javascript\nconst fs = require('fs');\n\nfunction main() {\n    const input = fs.readFileSync('/dev/stdin', 'utf8').trim();\n    const parts = input.split(/\\s+/);\n    let n = Number(parts[0]);\n    let k = Number(parts[1]);\n\n    const MOD = 1000000007n;\n\n    function modpow(base, exp, mod) {\n        base = base % mod;\n        if (base < 0n) base += mod;\n        let result = 1n;\n        while (exp > 0n) {\n            if (exp & 1n) result = (result * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1n;\n        }\n        return result;\n    }\n\n    function factorize(num) {\n        let factors = {};\n        let m = num;\n        for (let i = 2; i * i <= m; i++) {\n            while (m % i === 0) {\n                factors[i] = (factors[i] || 0) + 1;\n                m = m / i;\n            }\n        }\n        if (m > 1) {\n            factors[m] = (factors[m] || 0) + 1;\n        }\n        return factors;\n    }\n\n    if (n === 1) {\n        console.log(\"1\");\n        return;\n    }\n\n    const factors = factorize(n);\n\n    let ans = 1n;\n\n    for (const key in factors) {\n        // key might be a string representation of a number (possibly large but within safe integer range)\n        const p = Number(key);\n        const e = factors[key];\n\n        const pBig = BigInt(Math.round(p)) % MOD;\n\n        // precompute inverses 1..e+1\n        const inv = new Array(e + 2);\n        for (let x = 1; x <= e + 1; x++) {\n            inv[x] = modpow(BigInt(x), MOD - 2n, MOD);\n        }\n\n        // dp array\n        let dp = new Array(e + 1).fill(0n);\n        dp[e] = 1n;\n\n        for (let step = 0; step < k; step++) {\n            let newdp = new Array(e + 1).fill(0n);\n            for (let j = 0; j <= e; j++) {\n                if (dp[j] === 0n) continue;\n                const contrib = (dp[j] * inv[j + 1]) % MOD;\n                for (let i = 0; i <= j; i++) {\n                    newdp[i] = (newdp[i] + contrib) % MOD;\n                }\n            }\n            dp = newdp;\n        }\n\n        // compute expected value sum dp[i]*p^i\n        let total = 0n;\n        let pPow = 1n; // p^0\n        for (let i = 0; i <= e; i++) {\n            total = (total + dp[i] * pPow) % MOD;\n            pPow = (pPow * pBig) % MOD;\n        }\n\n        ans = (ans * total) % MOD;\n    }\n\n    console.log(ans.toString());\n}\n\nmain();\n```",
