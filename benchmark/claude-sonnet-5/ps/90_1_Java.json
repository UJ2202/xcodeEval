                    "content": "```java\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        long k = scanner.nextLong();\n\n        // Determine m: smallest m<=n such that m! >= k\n        long fact = 1;\n        int m = 0;\n        while (fact < k && m < n) {\n            m++;\n            fact *= m;\n            if (fact > (long) 4e18) { // avoid overflow, but k<=1e9 so this won't be reached normally\n                break;\n            }\n        }\n\n        if (fact < k) {\n            System.out.println(-1);\n            return;\n        }\n\n        // partA: count lucky numbers <= n-m (since positions there have ai = i)\n        long limitA = n - m;\n        long partA = countLuckyUpTo(limitA);\n\n        // Now compute permutation tail of size m using factorial number system\n        long count = partA;\n\n        if (m > 0) {\n            // available values: n-m+1 ... n\n            List<Long> available = new ArrayList<>();\n            for (long v = n - m + 1; v <= n; v++) {\n                available.add(v);\n            }\n\n            // precompute factorials up to m\n            long[] factArr = new long[m + 1];\n            factArr[0] = 1;\n            for (int i = 1; i <= m; i++) {\n                factArr[i] = factArr[i - 1] * i;\n            }\n\n            long idx = k - 1; // 0-indexed\n\n            for (int i = 0; i < m; i++) {\n                int remaining = m - 1 - i; // remaining elements after this pick\n                long f = factArr[remaining];\n                int pos = (int) (idx / f);\n                idx = idx % f;\n\n                long value = available.get(pos);\n                available.remove(pos);\n\n                long position = n - m + 1 + i;\n\n                if (isLucky(position) && isLucky(value)) {\n                    count++;\n                }\n            }\n        }\n\n        System.out.println(count);\n    }\n\n    private static boolean isLucky(long x) {\n        if (x <= 0) return false;\n        while (x > 0) {\n            long d = x % 10;\n            if (d != 4 && d != 7) return false;\n            x /= 10;\n        }\n        return true;\n    }\n\n    private static long countLuckyUpTo(long limit) {\n        if (limit <= 0) return 0;\n        List<Long> luckyNumbers = new ArrayList<>();\n        generateLucky(0, luckyNumbers, limit);\n        return luckyNumbers.size();\n    }\n\n    private static void generateLucky(long current, List<Long> list, long limit) {\n        if (current > limit && current != 0) {\n            return;\n        }\n        if (current != 0) {\n            list.add(current);\n        }\n        if (current > limit) {\n            return;\n        }\n        long next4 = current * 10 + 4;\n        long next7 = current * 10 + 7;\n        if (next4 <= limit || current == 0) {\n            if (next4 <= 2000000000L) { // safety bound\n                generateLucky(next4, list, limit);\n            }\n        }\n        if (next7 <= limit || current == 0) {\n            if (next7 <= 2000000000L) {\n                generateLucky(next7, list, limit);\n            }\n        }\n    }\n}\n```",
