                    "content": "```kotlin\nimport java.io.BufferedReader\nimport java.io.InputStreamReader\nimport java.util.StringTokenizer\n\nfun isLucky(x: Long): Boolean {\n    val s = x.toString()\n    return s.all { it == '4' || it == '7' }\n}\n\nfun genLucky(len: Int, cur: StringBuilder, list: MutableList<Long>) {\n    if (cur.length == len) {\n        list.add(cur.toString().toLong())\n        return\n    }\n    cur.append('4')\n    genLucky(len, cur, list)\n    cur.deleteCharAt(cur.length - 1)\n    cur.append('7')\n    genLucky(len, cur, list)\n    cur.deleteCharAt(cur.length - 1)\n}\n\nfun luckyNumbersUpTo(n: Long): List<Long> {\n    val list = mutableListOf<Long>()\n    for (len in 1..9) {\n        genLucky(len, StringBuilder(), list)\n    }\n    return list.filter { it <= n }\n}\n\nfun main() {\n    val br = BufferedReader(InputStreamReader(System.`in`))\n    val line = br.readLine()!!.trim()\n    val st = StringTokenizer(line)\n    val n = st.nextToken().toLong()\n    val k = st.nextToken().toLong()\n\n    val fact = LongArray(14)\n    fact[0] = 1\n    for (i in 1..13) {\n        fact[i] = fact[i - 1] * i\n    }\n\n    // Check validity\n    if (n < 13) {\n        val nf = fact[n.toInt()]\n        if (k > nf) {\n            println(-1)\n            return\n        }\n    }\n\n    // Determine m: smallest m such that fact[m] >= k\n    var m = 0\n    while (m <= 13 && fact[m] < k) {\n        m++\n    }\n    // m should be <= n by construction (validity checked above for n<13, and for n>=13, m<=13<=n)\n\n    val tailStart = n - m\n\n    // Build available list for the tail part\n    val avail = mutableListOf<Long>()\n    var v = tailStart + 1\n    while (v <= n) {\n        avail.add(v)\n        v++\n    }\n\n    var remaining = k - 1\n    val result = mutableListOf<Long>()\n    var i = m\n    while (i >= 1) {\n        val f = fact[i - 1]\n        val idx = (remaining / f).toInt()\n        remaining %= f\n        result.add(avail[idx])\n        avail.removeAt(idx)\n        i--\n    }\n\n    val luckyList = luckyNumbersUpTo(n)\n    var count = 0\n\n    for (L in luckyList) {\n        if (L <= tailStart) {\n            // a_L = L, which is lucky by definition of L being in luckyList\n            count++\n        } else {\n            val idx = (L - tailStart - 1).toInt()\n            if (idx in result.indices) {\n                val value = result[idx]\n                if (isLucky(value)) {\n                    count++\n                }\n            }\n        }\n    }\n\n    println(count)\n}\n```",
