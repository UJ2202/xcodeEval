                    "content": "fun main() {\n    val n = readLine()!!.trim().toLong()\n    val nStr = n.toString()\n    val maxLen = nStr.length\n\n    val luckySet = HashSet<Long>()\n\n    for (x in 0..9) {\n        for (y in x..9) {\n            for (len in 1..maxLen) {\n                val totalCombos = 1 shl len\n                for (mask in 0 until totalCombos) {\n                    val sb = StringBuilder()\n                    for (bitPos in 0 until len) {\n                        val bit = (mask shr bitPos) and 1\n                        val digit = if (bit == 0) x else y\n                        sb.append(digit)\n                    }\n                    val s = sb.toString()\n                    if (s[0] == '0') continue\n                    val value = s.toLong()\n                    if (value <= n) {\n                        luckySet.add(value)\n                    }\n                }\n            }\n        }\n    }\n\n    println(luckySet.size)\n}",
