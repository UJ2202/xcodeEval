\n        }\n        return order;\n    }\n    \n    static List<Long> factorize(long n) {\n        List<Long> factors = new ArrayList<>();\n        for (long i = 2; i * i <= n; i++) {\n            if (n % i == 0) {\n                factors.add(i);\n                while (n % i == 0) n /= i;\n            }\n        }\n        if (n > 1) factors.add(n);\n        return factors;\n    }\n}\n```",
