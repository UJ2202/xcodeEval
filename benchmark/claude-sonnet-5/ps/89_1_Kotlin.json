                "message": {
                    "content": "```kotlin\nimport java.util.Scanner\n\nfun main() {\n    val scanner = Scanner(System.`in`)\n    val n = scanner.nextInt()\n    val m = scanner.nextInt()\n\n    val rows = minOf(n, m)\n    val cols = maxOf(n, m)\n    val full = (1 shl rows) - 1\n    val size = 1 shl rows\n    val INF = Int.MAX_VALUE / 2\n\n    // dp[S][U] = min cost, S = dominators chosen in current column,\n    // U = bitmask of cells in current column not yet dominated (need next column to cover)\n    var dp = Array(size) { IntArray(size) { INF } }\n\n    for (s0 in 0 until size) {\n        val vert = ((s0 shl 1) or (s0 shr 1)) and full\n        val dominated = (s0 or vert) and full\n        val u0 = full and dominated.inv()\n        val cost = Integer.bitCount(s0)\n        if (cost < dp[s0][u0]) dp[s0][u0] = cost\n    }\n\n    for (col in 1 until cols) {\n        val ndp = Array(size) { IntArray(size) { INF } }\n        for (sp in 0 until size) {\n            for (u in 0 until size) {\n                val cur = dp[sp][u]\n                if (cur >= INF) continue\n                for (sn in 0 until size) {\n                    if ((u and sn) != u) continue // sn must cover all undominated bits from previous column\n                    val vert = ((sn shl 1) or (sn shr 1)) and full\n                    val dominated = (sn or sp or vert) and full\n                    val unext = full and dominated.inv()\n                    val cost = cur + Integer.bitCount(sn)\n                    if (cost < ndp[sn][unext]) ndp[sn][unext] = cost\n                }\n            }\n        }\n        dp = ndp\n    }\n\n    var best = INF\n    for (s in 0 until size) {\n        if (dp[s][0] < best) best = dp[s][0]\n    }\n\n    println(n * m - best)\n}\n```",
