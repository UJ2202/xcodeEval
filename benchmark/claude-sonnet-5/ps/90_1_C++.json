                    "content": "```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nbool isLucky(long long x){\n    if(x<=0) return false;\n    while(x>0){\n        int d = x % 10;\n        if(d != 4 && d != 7) return false;\n        x /= 10;\n    }\n    return true;\n}\n\nint main(){\n    long long n, k;\n    cin >> n >> k;\n\n    vector<long long> fact(21);\n    fact[0] = 1;\n    for(int i = 1; i <= 20; i++){\n        fact[i] = fact[i-1] * i;\n        if(fact[i] > 2000000000LL) fact[i] = 2000000000LL;\n    }\n\n    long long t;\n    if(n < 13){\n        if(k > fact[n]){\n            cout << -1 << endl;\n            return 0;\n        }\n        t = n;\n    } else {\n        t = 13;\n    }\n\n    long long start = n - t + 1;\n    vector<long long> nums(t);\n    for(long long i = 0; i < t; i++) nums[i] = start + i;\n\n    vector<long long> perm;\n    long long kk = k - 1;\n    vector<long long> avail(nums);\n    for(long long i = t; i >= 1; i--){\n        long long f = fact[i-1];\n        long long idx = kk / f;\n        kk %= f;\n        perm.push_back(avail[idx]);\n        avail.erase(avail.begin() + idx);\n    }\n\n    long long count = 0;\n\n    vector<long long> luckyNums;\n    for(int len = 1; len <= 10; len++){\n        int cnt = 1 << len;\n        for(int mask = 0; mask < cnt; mask++){\n            long long num = 0;\n            for(int b = 0; b < len; b++){\n                num = num * 10 + ((mask & (1 << b)) ? 7 : 4);\n            }\n            luckyNums.push_back(num);\n        }\n    }\n\n    long long prefixLen = n - t;\n    for(auto ln : luckyNums){\n        if(ln <= prefixLen) count++;\n    }\n\n    for(long long idx = 0; idx < t; idx++){\n        long long pos = start + idx;\n        long long val = perm[idx];\n        if(isLucky(pos) && isLucky(val)) count++;\n    }\n\n    cout << count << endl;\n    return 0;\n}\n```",
