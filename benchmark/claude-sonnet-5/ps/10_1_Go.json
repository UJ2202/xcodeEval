                    "content": "```go\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n)\n\nconst MOD = 1000000007\n\nfunc modpow(base, exp, mod int64) int64 {\n\tbase %= mod\n\tif base < 0 {\n\t\tbase += mod\n\t}\n\tresult := int64(1)\n\tfor exp > 0 {\n\t\tif exp&1 == 1 {\n\t\t\tresult = result * base % mod\n\t\t}\n\t\tbase = base * base % mod\n\t\texp >>= 1\n\t}\n\treturn result\n}\n\nfunc main() {\n\treader := bufio.NewReader(os.Stdin)\n\tvar x, n int64\n\tfmt.Fscan(reader, &x, &n)\n\n\tprimes := []int64{}\n\ttemp := x\n\tfor p := int64(2); p*p <= temp; p++ {\n\t\tif temp%p == 0 {\n\t\t\tprimes = append(primes, p)\n\t\t\tfor temp%p == 0 {\n\t\t\t\ttemp /= p\n\t\t\t}\n\t\t}\n\t}\n\tif temp > 1 {\n\t\tprimes = append(primes, temp)\n\t}\n\n\tans := int64(1)\n\tmodMinus1 := int64(MOD - 1)\n\n\tfor _, p := range primes {\n\t\t// compute exponent = sum_{k=1}^{inf} floor(n / p^k)\n\t\tvar exponent int64 = 0\n\t\tpk := p\n\t\tfor pk <= n {\n\t\t\texponent += n / pk\n\t\t\tif pk > n/p {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tpk *= p\n\t\t}\n\t\texpMod := exponent % modMinus1\n\t\tterm := modpow(p, expMod, MOD)\n\t\tans = ans * term % MOD\n\t}\n\n\tfmt.Println(ans)\n}\n```",
