                    "content": "```php\n<?php\n$MOD = 1000000007;\n\nfunction modpow($base, $exp, $mod) {\n    $base = $base % $mod;\n    if ($base < 0) $base += $mod;\n    $result = 1;\n    while ($exp > 0) {\n        if ($exp & 1) {\n            $result = ($result * $base) % $mod;\n        }\n        $base = ($base * $base) % $mod;\n        $exp >>= 1;\n    }\n    return $result;\n}\n\nfunction modinv($a, $mod) {\n    return modpow($a, $mod - 2, $mod);\n}\n\nfunction factorize($n) {\n    $factors = [];\n    while ($n % 2 == 0) {\n        $factors[2] = ($factors[2] ?? 0) + 1;\n        $n = intdiv($n, 2);\n    }\n    for ($p = 3; $p * $p <= $n; $p += 2) {\n        while ($n % $p == 0) {\n            $factors[$p] = ($factors[$p] ?? 0) + 1;\n            $n = intdiv($n, $p);\n        }\n    }\n    if ($n > 1) {\n        $factors[$n] = ($factors[$n] ?? 0) + 1;\n    }\n    return $factors;\n}\n\nfscanf(STDIN, \"%d %d\", $n, $k);\n\n$n = (int)$n;\n$k = (int)$k;\n\nif ($n == 1) {\n    echo 1 . \"\\n\";\n    exit;\n}\n\n$factors = factorize($n);\n\n$answer = 1;\n\nforeach ($factors as $p => $e) {\n    // p might exceed int range but PHP ints are 64-bit, fine for n <= 1e15\n    $pMod = $p % $MOD;\n    \n    // precompute inverses of 1..(e+1)\n    $inv = [];\n    for ($i = 1; $i <= $e + 1; $i++) {\n        $inv[$i] = modinv($i, $MOD);\n    }\n    \n    // prob array indexed 0..e\n    $prob = array_fill(0, $e + 1, 0);\n    $prob[$e] = 1;\n    \n    for ($step = 0; $step < $k; $step++) {\n        $newProb = array_fill(0, $e + 1, 0);\n        $cur = 0;\n        for ($i = $e; $i >= 0; $i--) {\n            $term = ($prob[$i] * $inv[$i + 1]) % $MOD;\n            $cur = ($cur + $term) % $MOD;\n            $newProb[$i] = $cur;\n        }\n        $prob = $newProb;\n    }\n    \n    // compute expectation = sum_i prob[i] * p^i mod MOD\n    $expectation = 0;\n    $pPow = 1; // p^0\n    for ($i = 0; $i <= $e; $i++) {\n        $term = ($prob[$i] * $pPow) % $MOD;\n        $expectation = ($expectation + $term) % $MOD;\n        $pPow = ($pPow * $pMod) % $MOD;\n    }\n    \n    $answer = ($answer * $expectation) % $MOD;\n}\n\necho $answer . \"\\n\";\n?>\n```",
