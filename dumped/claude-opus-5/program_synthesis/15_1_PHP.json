                    "content": "```php\n<?php\nfunction powmod($b, $e, $m) {\n    $r = 1;\n    $b %= $m;\n    while ($e > 0) {\n        if ($e & 1) $r = $r * $b % $m;\n        $b = $b * $b % $m;\n        $e >>= 1;\n    }\n    return $r;\n}\n\n$MOD = 998244353;\n\n$line = trim(fgets(STDIN));\n$parts = preg_split('/\\s+/', $line);\n$n = (int)$parts[0];\n$k = (int)$parts[1];\n$l = (int)$parts[2];\n\n$N = 2 * $n + 1;\n\n$fact = array_fill(0, $N + 1, 1);\nfor ($i = 1; $i <= $N; $i++) {\n    $fact[$i] = $fact[$i - 1] * $i % $MOD;\n}\n$invfact = array_fill(0, $N + 1, 1);\n$invfact[$N] = powmod($fact[$N], $MOD - 2, $MOD);\nfor ($i = $N; $i >= 1; $i--) {\n    $invfact[$i - 1] = $invfact[$i] * $i % $MOD;\n}\n$pow2 = array_fill(0, $n + 1, 1);\nfor ($i = 1; $i <= $n; $i++) {\n    $pow2[$i] = $pow2[$i - 1] * 2 % $MOD;\n}\n\n$total = 0;\n$factn = $fact[$n];\nfor ($j = $k; $j <= $n; $j++) {\n    $m = $n - $j;\n    $s = 0;\n    $a = $j;\n    $b = 2 * $n - $j;\n    for ($i = 0; $i <= $m; $i++) {\n        $s = ($s + $invfact[$i] * $invfact[$m - $i] % $MOD * $fact[$a] % $MOD * $fact[$b]) % $MOD;\n        $a += 2;\n        $b -= 2;\n    }\n    // C(n,j)*fact[m] = fact[n]*invfact[j]\n    $c = $s * $factn % $MOD * $invfact[$j] % $MOD * $pow2[$j] % $MOD;\n    $total = ($total + $c) % $MOD;\n}\n\n$ans = $total * $invfact[$N] % $MOD;\n$ans = $ans * ($l % $MOD) % $MOD;\n\necho $ans, \"\\n\";\n```",
