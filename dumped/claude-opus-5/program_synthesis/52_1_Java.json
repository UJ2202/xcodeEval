                    "content": "```java\nimport java.util.*;\nimport java.math.BigInteger;\n\npublic class Main {\n    static List<long[]> entries;\n\n    static long solve(long rem, long minP) {\n        if (rem == 1) return 1;\n        long ans = 0;\n        for (long[] e : entries) {\n            long d = e[0];\n            if (d > rem) break;\n            if (rem % d == 0) {\n                for (int i = 1; i < e.length; i++) {\n                    if (e[i] >= minP) {\n                        ans += solve(rem / d, e[i] + 1);\n                    }\n                }\n            }\n        }\n        return ans;\n    }\n\n    static boolean isPrime(long n) {\n        if (n < 2) return false;\n        return BigInteger.valueOf(n).isProbablePrime(35);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long A = sc.nextLong();\n        if (A == 1) {\n            System.out.println(1);\n            return;\n        }\n        // factor A\n        long tmp = A;\n        List<long[]> fac = new ArrayList<>();\n        for (long p = 2; p * p <= tmp; p++) {\n            if (tmp % p == 0) {\n                int c = 0;\n                while (tmp % p == 0) { tmp /= p; c++; }\n                fac.add(new long[]{p, c});\n            }\n        }\n        if (tmp > 1) fac.add(new long[]{tmp, 1});\n        // divisors\n        List<Long> divsList = new ArrayList<>();\n        divsList.add(1L);\n        for (long[] f : fac) {\n            int sz = divsList.size();\n            long pw = 1;\n            List<Long> add = new ArrayList<>();\n            for (int e = 1; e <= f[1]; e++) {\n                pw *= f[0];\n                for (int i = 0; i < sz; i++) {\n                    add.add(divsList.get(i) * pw);\n                }\n            }\n            divsList.addAll(add);\n        }\n        Collections.sort(divsList);\n        HashSet<Long> divSet = new HashSet<>(divsList);\n        HashMap<Long, List<Long>> map = new HashMap<>();\n\n        int LIM = 1000000;\n        boolean[] comp = new boolean[LIM + 1];\n        for (int i = 2; (long) i * i <= LIM; i++) {\n            if (!comp[i]) {\n                for (int j = i * i; j <= LIM; j += i) comp[j] = true;\n            }\n        }\n        for (int p = 2; p <= LIM; p++) {\n            if (comp[p]) continue;\n            long pw = p;\n            long s = 1 + p;\n            while (true) {\n                if (pw > A / p) break;\n                pw *= p;\n                if (s > A - pw) { s = A + 1; }\n                else s += pw;\n                if (s > A) break;\n                if (divSet.contains(s)) {\n                    map.computeIfAbsent(s, k -> new ArrayList<>()).add((long) p);\n                }\n            }\n        }\n        for (long d : divsList) {\n            if (d > 1) {\n                long cand = d - 1;\n                if (cand >= 2 && isPrime(cand)) {\n                    map.computeIfAbsent(d, k -> new ArrayList<>()).add(cand);\n                }\n            }\n        }\n        entries = new ArrayList<>();\n        for (long d : divsList) {\n            List<Long> lst = map.get(d);\n            if (lst != null && !lst.isEmpty()) {\n                long[] e = new long[lst.size() + 1];\n                e[0] = d;\n                for (int i = 0; i < lst.size(); i++) e[i + 1] = lst.get(i);\n                entries.add(e);\n            }\n        }\n        entries.sort((a, b) -> Long.compare(a[0], b[0]));\n\n        System.out.println(solve(A, 2));\n    }\n}\n```",
