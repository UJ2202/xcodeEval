                    "content": "```javascript\nconst data = require('fs').readFileSync(0, 'utf8').trim().split(/\\s+/);\nlet n = Number(data[0]);\nconst k = Number(data[1]);\nconst MOD = 1000000007;\n\nfunction mulmod(a, b) {\n  // a, b < MOD\n  const ah = Math.floor(a / 65536), al = a % 65536;\n  return ((ah * b % MOD) * 65536 + al * b) % MOD;\n}\n\nfunction powmod(a, e) {\n  a %= MOD;\n  let r = 1;\n  while (e > 0) {\n    if (e & 1) r = mulmod(r, a);\n    a = mulmod(a, a);\n    e = Math.floor(e / 2);\n  }\n  return r;\n}\n\n// factorize n\nconst primes = [];\nconst exps = [];\nlet m = n;\nfor (let i = 2; i * i <= m; i++) {\n  if (m % i === 0) {\n    let c = 0;\n    while (m % i === 0) { m = m / i; c++; }\n    primes.push(i);\n    exps.push(c);\n  }\n}\nif (m > 1) { primes.push(m); exps.push(1); }\n\nlet maxE = 0;\nfor (const e of exps) if (e > maxE) maxE = e;\n\n// inverses of 1..maxE+1\nconst inv = new Array(maxE + 2).fill(0);\nfor (let i = 1; i <= maxE + 1; i++) inv[i] = powmod(i, MOD - 2);\n\nlet ans = 1;\nfor (let idx = 0; idx < primes.length; idx++) {\n  const p = primes[idx] % MOD;\n  const e = exps[idx];\n  let cur = new Float64Array(0); // placeholder\n  let arr = new Array(e + 1).fill(0);\n  arr[e] = 1;\n  let nxt = new Array(e + 1).fill(0);\n  for (let step = 0; step < k; step++) {\n    let s = 0;\n    for (let i = e; i >= 0; i--) {\n      s = (s + mulmod(arr[i], inv[i + 1])) % MOD;\n      nxt[i] = s;\n    }\n    const tmp = arr; arr = nxt; nxt = tmp;\n  }\n  let val = 0;\n  let pw = 1;\n  for (let i = 0; i <= e; i++) {\n    val = (val + mulmod(arr[i], pw)) % MOD;\n    pw = mulmod(pw, p);\n  }\n  ans = mulmod(ans, val);\n}\n\nconsole.log(String(ans));\n```",
