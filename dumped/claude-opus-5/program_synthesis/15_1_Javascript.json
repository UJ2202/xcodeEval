                    "content": "```javascript\nconst data = require('fs').readFileSync(0, 'utf8').split(/\\s+/);\nconst n = parseInt(data[0]);\nconst k = parseInt(data[1]);\nconst l = parseInt(data[2]);\nconst MOD = 998244353;\n\nfunction mul(a, b) {\n  const ah = Math.floor(a / 65536), al = a % 65536;\n  return ((ah * b % MOD) * 65536 + al * b) % MOD;\n}\n\nfunction power(a, e) {\n  a %= MOD;\n  let r = 1;\n  while (e > 0) {\n    if (e & 1) r = mul(r, a);\n    a = mul(a, a);\n    e = Math.floor(e / 2);\n  }\n  return r;\n}\n\nconst N = 2 * n + 2;\nconst fact = new Array(N + 1);\nconst invfact = new Array(N + 1);\nfact[0] = 1;\nfor (let i = 1; i <= N; i++) fact[i] = mul(fact[i - 1], i);\ninvfact[N] = power(fact[N], MOD - 2);\nfor (let i = N; i >= 1; i--) invfact[i - 1] = mul(invfact[i], i);\n\nfunction C(a, b) {\n  if (b < 0 || b > a) return 0;\n  return mul(fact[a], mul(invfact[b], invfact[a - b]));\n}\n\nconst pow2 = new Array(n + 1);\npow2[0] = 1;\nfor (let i = 1; i <= n; i++) pow2[i] = (pow2[i - 1] * 2) % MOD;\n\nlet total = 0;\nfor (let j = k; j <= n; j++) {\n  const m = n - j;\n  let inner = 0;\n  for (let i = 0; i <= m; i++) {\n    const a = j + 2 * i;\n    const b = 2 * n - j - 2 * i;\n    inner = (inner + mul(C(m, i), mul(fact[a], fact[b]))) % MOD;\n  }\n  total = (total + mul(mul(C(n, j), pow2[j]), inner)) % MOD;\n}\n\nlet ans = mul(total, invfact[2 * n + 1]);\nans = mul(ans, l % MOD);\nconsole.log(ans.toString());\n```",
