                    "content": "```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst ll MOD = 998244353;\n\nll pw(ll b, ll e, ll m){ ll r=1; b%=m; while(e){ if(e&1) r=r*b%m; b=b*b%m; e>>=1;} return r;}\n\nint main(){\n    ll n,k,l;\n    if(!(cin>>n>>k>>l)) return 0;\n    int N = 2*n;\n    vector<ll> fact(N+2), invfact(N+2);\n    fact[0]=1;\n    for(int i=1;i<=N+1;i++) fact[i]=fact[i-1]*i%MOD;\n    invfact[N+1]=pw(fact[N+1],MOD-2,MOD);\n    for(int i=N+1;i>=1;i--) invfact[i-1]=invfact[i]*i%MOD;\n    // g[t] = (2t-1)!!\n    vector<ll> g(n+2);\n    g[0]=1;\n    for(int t=1;t<=(int)n;t++) g[t]=g[t-1]*((2LL*t-1)%MOD)%MOD;\n\n    auto C=[&](int a,int b)->ll{\n        if(b<0||b>a||a<0) return 0;\n        return fact[a]*invfact[b]%MOD*invfact[a-b]%MOD;\n    };\n\n    ll S=0;\n    for(int i=0;i<=N;i++){\n        int mx = min(i, N-i);\n        int j0 = (int)k;\n        if(((j0 - i)%2+2)%2 != 0) j0++;\n        for(int j=j0;j<=mx;j+=2){\n            int a=(i-j)/2, b=(N-i-j)/2;\n            ll term = C(i,j)*C(N-i,j)%MOD*fact[j]%MOD*g[a]%MOD*g[b]%MOD;\n            S=(S+term)%MOD;\n        }\n    }\n    ll ans = S % MOD;\n    ans = ans * pw(g[n],MOD-2,MOD)%MOD;\n    ans = ans * pw((ll)(N+1),MOD-2,MOD)%MOD;\n    ans = ans * (l%MOD)%MOD;\n    cout<<ans<<endl;\n    return 0;\n}\n```",
