                    "content": "```python\nimport sys\nfrom itertools import product\n\ndef main():\n    data = sys.stdin.read().split()\n    n, k = int(data[0]), int(data[1])\n    m = 0\n    f = 1\n    while m < n and f < k:\n        m += 1\n        f *= m\n    if f < k:\n        print(-1)\n        return\n    base = n - m\n\n    def is_lucky(x):\n        s = str(x)\n        return all(c in '47' for c in s)\n\n    # count lucky numbers <= base\n    cnt = 0\n    for length in range(1, 11):\n        for combo in product('47', repeat=length):\n            v = int(''.join(combo))\n            if v <= base:\n                cnt += 1\n\n    nums = list(range(base + 1, n + 1))\n    kk = k - 1\n    perm = []\n    # factorials\n    fact = [1] * (m + 1)\n    for i in range(1, m + 1):\n        fact[i] = fact[i - 1] * i\n    for i in range(m, 0, -1):\n        idx = kk // fact[i - 1]\n        kk %= fact[i - 1]\n        perm.append(nums.pop(idx))\n\n    for i in range(m):\n        pos = base + 1 + i\n        val = perm[i]\n        if is_lucky(pos) and is_lucky(val):\n            cnt += 1\n    print(cnt)\n\nmain()\n```",
