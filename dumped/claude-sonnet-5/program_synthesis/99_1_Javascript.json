                "message": {
                    "content": "```javascript\nconst readline = require('readline');\nconst rl = readline.createInterface({ input: process.stdin, terminal: false });\nlet inputLines = [];\nrl.on('line', (line) => inputLines.push(line.trim()));\nrl.on('close', () => {\n    const [n, t] = inputLines[0].split(' ').map(Number);\n    console.log(solve(n, t));\n});\n\nfunction solve(n, t) {\n    // dp keyed by \"y_dirPrev_h_v\" -> count\n    // dirPrev: -1 means no previous direction (only valid for i=1)\n    // h = number of humps found so far, v = number of valleys found so far\n    let dp = new Map();\n\n    for (let y = 1; y <= 4; y++) {\n        const key = `${y}_-1_0_0`;\n        dp.set(key, (dp.get(key) || 0) + 1);\n    }\n\n    for (let i = 2; i <= n; i++) {\n        const ndp = new Map();\n        for (const [key, count] of dp) {\n            const parts = key.split('_').map(Number);\n            const y = parts[0], dirPrev = parts[1], h = parts[2], v = parts[3];\n\n            for (let ny = 1; ny <= 4; ny++) {\n                if (ny === y) continue; // no horizontal segments allowed\n                const newDir = ny > y ? 1 : 0;\n                let nh = h, nv = v;\n\n                if (dirPrev !== -1) {\n                    if (dirPrev === 1 && newDir === 0) {\n                        nh++; // hump: up then down\n                    } else if (dirPrev === 0 && newDir === 1) {\n                        nv++; // valley: down then up\n                    }\n                }\n\n                if (nh > t || nv > t - 1) continue; // prune invalid states early\n\n                const nkey = `${ny}_${newDir}_${nh}_${nv}`;\n                ndp.set(nkey, (ndp.get(nkey) || 0) + count);\n            }\n        }\n        dp = ndp;\n    }\n\n    let total = 0;\n    for (const [key, count] of dp) {\n        const parts = key.split('_').map(Number);\n        const h = parts[2], v = parts[3];\n        if (h === t && v === t - 1) {\n            total += count;\n        }\n    }\n\n    return total;\n}\n```",
