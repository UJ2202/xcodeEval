                    "content": "```go\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n)\n\nconst MOD = 1000000007\n\nfunc modpow(base, exp int64, mod int64) int64 {\n\tbase %= mod\n\tif base < 0 {\n\t\tbase += mod\n\t}\n\tresult := int64(1)\n\tfor exp > 0 {\n\t\tif exp&1 == 1 {\n\t\t\tresult = result * base % mod\n\t\t}\n\t\tbase = base * base % mod\n\t\texp >>= 1\n\t}\n\treturn result\n}\n\nfunc main() {\n\treader := bufio.NewReader(os.Stdin)\n\tvar n, k int64\n\tfmt.Fscan(reader, &n, &k)\n\n\tfactors := make(map[int64]int64)\n\tnum := n\n\tfor i := int64(2); i*i <= num; i++ {\n\t\tfor num%i == 0 {\n\t\t\tfactors[i]++\n\t\t\tnum /= i\n\t\t}\n\t}\n\tif num > 1 {\n\t\tfactors[num]++\n\t}\n\n\tans := int64(1)\n\n\tfor p, e := range factors {\n\t\tsize := int(e) + 1\n\t\tdp := make([]int64, size)\n\t\tdp[e] = 1\n\n\t\tinvs := make([]int64, size)\n\t\tfor i := 0; i < size; i++ {\n\t\t\tinvs[i] = modpow(int64(i+1), MOD-2, MOD)\n\t\t}\n\n\t\tfor step := int64(0); step < k; step++ {\n\t\t\tnewdp := make([]int64, size)\n\t\t\tsuffix := int64(0)\n\t\t\tfor i := size - 1; i >= 0; i-- {\n\t\t\t\tterm := dp[i] * invs[i] % MOD\n\t\t\t\tsuffix = (suffix + term) % MOD\n\t\t\t\tnewdp[i] = suffix\n\t\t\t}\n\t\t\tdp = newdp\n\t\t}\n\n\t\tpmodp := p % MOD\n\t\tppow := make([]int64, size)\n\t\tppow[0] = 1\n\t\tfor j := 1; j < size; j++ {\n\t\t\tppow[j] = ppow[j-1] * pmodp % MOD\n\t\t}\n\n\t\tval := int64(0)\n\t\tfor j := 0; j < size; j++ {\n\t\t\tval = (val + dp[j]*ppow[j]) % MOD\n\t\t}\n\n\t\tans = ans * val % MOD\n\t}\n\n\tfmt.Println(ans)\n}\n```",
