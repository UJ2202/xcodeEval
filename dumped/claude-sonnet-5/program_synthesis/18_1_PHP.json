                    "content": "```php\n<?php\n\nfunction modpow($base, $exp, $mod) {\n    $base = $base % $mod;\n    if ($base < 0) $base += $mod;\n    $result = 1;\n    while ($exp > 0) {\n        if ($exp & 1) {\n            $result = ($result * $base) % $mod;\n        }\n        $base = ($base * $base) % $mod;\n        $exp >>= 1;\n    }\n    return $result;\n}\n\nfunction primeFactors($n) {\n    $factors = [];\n    for ($i = 2; $i * $i <= $n; $i++) {\n        if ($n % $i == 0) {\n            $factors[] = $i;\n            while ($n % $i == 0) {\n                $n = intdiv($n, $i);\n            }\n        }\n    }\n    if ($n > 1) {\n        $factors[] = $n;\n    }\n    return $factors;\n}\n\n$line = trim(fgets(STDIN));\n$parts = preg_split('/\\s+/', $line);\n$a = (int)$parts[0];\n$b = (int)$parts[1];\n$p = (int)$parts[2];\n$x = (int)$parts[3];\n\n// Compute multiplicative order of a modulo p\n$d = $p - 1;\n$factors = primeFactors($p - 1);\nforeach ($factors as $f) {\n    while ($d % $f == 0 && modpow($a, intdiv($d, $f), $p) == 1) {\n        $d = intdiv($d, $f);\n    }\n}\n\n$ainv = modpow($a, $p - 2, $p);\n$invd = modpow($d, $p - 2, $p);\n\n$M = $d * $p;\n\n$total = 0;\n$pow_ainv = 1; // a^{-r} mod p, starting with r=0 -> 1\n\nfor ($r = 0; $r < $d; $r++) {\n    $c_r = ($b * $pow_ainv) % $p;\n    $diff = (($c_r - $r) % $p + $p) % $p;\n    $t0 = ($diff * $invd) % $p;\n    $n0 = $r + $d * $t0;\n    if ($n0 == 0) {\n        $n0 = $M;\n    }\n    if ($n0 <= $x) {\n        $total += intdiv($x - $n0, $M) + 1;\n    }\n    $pow_ainv = ($pow_ainv * $ainv) % $p;\n}\n\necho $total . \"\\n\";\n```",
