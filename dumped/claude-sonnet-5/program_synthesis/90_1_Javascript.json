                    "content": "```javascript\nconst readline = require('readline');\nconst rl = readline.createInterface({ input: process.stdin, terminal: false });\nlet input = [];\nrl.on('line', l => input.push(l));\nrl.on('close', () => {\n    const [n, k] = input[0].split(' ').map(Number);\n    solve(n, k);\n});\n\nfunction isLucky(v) {\n    if (v <= 0) return false;\n    const s = v.toString();\n    for (const c of s) {\n        if (c !== '4' && c !== '7') return false;\n    }\n    return true;\n}\n\nfunction generateLucky(maxLen) {\n    const result = [];\n    function rec(cur) {\n        if (cur.length > maxLen) return;\n        if (cur.length > 0) result.push(parseInt(cur, 10));\n        rec(cur + '4');\n        rec(cur + '7');\n    }\n    rec('');\n    return result;\n}\n\nconst luckySet = generateLucky(10);\n\nfunction countLuckyUpTo(X) {\n    let cnt = 0;\n    for (const v of luckySet) {\n        if (v <= X) cnt++;\n    }\n    return cnt;\n}\n\nfunction solve(n, k) {\n    // Check existence of k-th permutation if n is small\n    if (n <= 20) {\n        let fact = 1n;\n        for (let i = 2; i <= n; i++) fact *= BigInt(i);\n        if (BigInt(k) > fact) {\n            console.log(-1);\n            return;\n        }\n    }\n\n    // Find minimal m such that m! >= k\n    let mFact = 1;\n    let m = 0;\n    while (mFact < k) {\n        m++;\n        mFact *= m;\n    }\n\n    // Precompute factorials up to m for permutation generation\n    const factorials = [1];\n    for (let i = 1; i <= m; i++) {\n        factorials.push(factorials[i - 1] * i);\n    }\n\n    const restCount = n - m; // number of fixed identity elements at the start\n    let answer = countLuckyUpTo(restCount);\n\n    if (m > 0) {\n        // Generate the last m elements as k-th permutation (1-indexed k)\n        const available = [];\n        for (let i = 0; i < m; i++) {\n            available.push(n - m + 1 + i);\n        }\n\n        let idx = k - 1; // 0-indexed rank\n        const result = [];\n        for (let i = 0; i < m; i++) {\n            const remaining = m - i - 1;\n            const f = factorials[remaining];\n            const pos = Math.floor(idx / f);\n            idx = idx % f;\n            const value = available.splice(pos, 1)[0];\n            result.push(value);\n        }\n\n        for (let j = 0; j < m; j++) {\n            const position = n - m + 1 + j;\n            const value = result[j];\n            if (isLucky(position) && isLucky(value)) {\n                answer++;\n            }\n        }\n    }\n\n    console.log(answer);\n}\n```",
