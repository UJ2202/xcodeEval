                    "content": "```php\n<?php\nfunction isLuckyNum($num) {\n    return preg_match('/^[47]+$/', (string)$num) === 1;\n}\n\nfunction countLuckyUpto($x) {\n    if ($x <= 0) return 0;\n    $count = 0;\n    for ($len = 1; $len <= 10; $len++) {\n        $total = 1 << $len;\n        for ($mask = 0; $mask < $total; $mask++) {\n            $numStr = '';\n            for ($b = $len - 1; $b >= 0; $b--) {\n                $numStr .= (($mask >> $b) & 1) ? '7' : '4';\n            }\n            $num = (int)$numStr;\n            if ($num <= $x) $count++;\n        }\n    }\n    return $count;\n}\n\n$line = trim(fgets(STDIN));\n$parts = preg_split('/\\s+/', $line);\n$n = (int)$parts[0];\n$k = (int)$parts[1];\n\n$limit = min($n, 20);\n$fact = array(1);\nfor ($i = 1; $i <= $limit; $i++) {\n    $fact[$i] = $fact[$i - 1] * $i;\n}\n\nif ($fact[$limit] < $k) {\n    echo -1;\n    exit;\n}\n\n$m = 0;\nfor ($i = 0; $i <= $limit; $i++) {\n    if ($fact[$i] >= $k) {\n        $m = $i;\n        break;\n    }\n}\n\n$elements = range($n - $m + 1, $n);\n$index = $k - 1;\n$result = array();\n\nfor ($i = $m; $i >= 1; $i--) {\n    $f = $fact[$i - 1];\n    $idx = intdiv($index, $f);\n    $result[] = $elements[$idx];\n    array_splice($elements, $idx, 1);\n    $index %= $f;\n}\n\n$count = countLuckyUpto($n - $m);\n\nforeach ($result as $j => $val) {\n    $pos = $n - $m + $j + 1;\n    if (isLuckyNum($pos) && isLuckyNum($val)) {\n        $count++;\n    }\n}\n\necho $count;\n```",
