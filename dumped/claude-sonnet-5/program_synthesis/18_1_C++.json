                    "content": "```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nlong long modpow(long long base, long long exp, long long mod){\n    base %= mod;\n    if(base < 0) base += mod;\n    long long result = 1;\n    while(exp > 0){\n        if(exp & 1) result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main(){\n    long long a, b, p, x;\n    cin >> a >> b >> p >> x;\n    \n    long long m = p - 1;\n    vector<long long> factors;\n    long long temp = m;\n    for(long long i = 2; i * i <= temp; i++){\n        if(temp % i == 0){\n            factors.push_back(i);\n            while(temp % i == 0) temp /= i;\n        }\n    }\n    if(temp > 1) factors.push_back(temp);\n    \n    long long d = m;\n    if(d == 0) d = 1;\n    \n    for(long long f : factors){\n        while(d % f == 0 && modpow(a, d / f, p) == 1){\n            d /= f;\n        }\n    }\n    if(d == 0) d = 1;\n    \n    long long inv_a = modpow(a, p - 2, p);\n    long long inv_d = modpow(d % p, p - 2, p);\n    \n    long long M = d * p;\n    long long ans = 0;\n    \n    long long pow_a = 1 % p;\n    long long inv_pow_a = 1 % p;\n    \n    for(long long r = 0; r < d; r++){\n        long long c_r = (b * inv_pow_a) % p;\n        long long diff = ((c_r - r) % p + p) % p;\n        long long t = (diff * inv_d) % p;\n        long long n0 = r + d * t;\n        \n        long long cnt;\n        if(n0 == 0){\n            cnt = x / M;\n        } else if(n0 <= x){\n            cnt = (x - n0) / M + 1;\n        } else {\n            cnt = 0;\n        }\n        ans += cnt;\n        \n        pow_a = (pow_a * a) % p;\n        inv_pow_a = (inv_pow_a * inv_a) % p;\n    }\n    \n    cout << ans << endl;\n    return 0;\n}\n```",
