                    "content": "```kotlin\nimport java.io.BufferedReader\nimport java.io.InputStreamReader\nimport java.util.StringTokenizer\n\nconst val MOD = 998244353L\n\nfun power(a: Long, e: Long, m: Long): Long {\n    var base = a % m\n    if (base < 0) base += m\n    var exp = e\n    var result = 1L\n    while (exp > 0) {\n        if (exp and 1L == 1L) result = result * base % m\n        base = base * base % m\n        exp = exp shr 1\n    }\n    return result\n}\n\nfun main() {\n    val br = BufferedReader(InputStreamReader(System.`in`))\n    val st = StringTokenizer(br.readLine())\n    val n = st.nextToken().toInt()\n    val k = st.nextToken().toInt()\n    val l = st.nextToken().toLong()\n\n    val maxN = 2 * n + 2\n    val fact = LongArray(maxN + 1)\n    val invFact = LongArray(maxN + 1)\n    fact[0] = 1\n    for (i in 1..maxN) fact[i] = fact[i - 1] * i % MOD\n    invFact[maxN] = power(fact[maxN], MOD - 2, MOD)\n    for (i in maxN downTo 1) invFact[i - 1] = invFact[i] * i % MOD\n\n    fun C(a: Int, b: Int): Long {\n        if (b < 0 || b > a) return 0L\n        return fact[a] * invFact[b] % MOD * invFact[a - b] % MOD\n    }\n\n    val pow2 = LongArray(n + 1)\n    pow2[0] = 1\n    for (i in 1..n) pow2[i] = pow2[i - 1] * 2 % MOD\n\n    var sum = 0L\n    for (i in k..n) {\n        val ci = C(n, i)\n        val p2 = pow2[i]\n        val cip = ci * p2 % MOD\n        val m = n - i\n        for (j in 0..m) {\n            val cj = C(m, j)\n            val a = i + 2 * j\n            val b = 2 * n - i - 2 * j\n            val term = cip * cj % MOD * fact[a] % MOD * fact[b] % MOD\n            sum = (sum + term) % MOD\n        }\n    }\n\n    val invFact2n1 = invFact[2 * n + 1]\n    var ans = sum * invFact2n1 % MOD\n    ans = ans * (l % MOD) % MOD\n    println(ans)\n}\n```",
