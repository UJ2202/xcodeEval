                    "content": "```python\nimport sys\nfrom itertools import product\n\ndef is_lucky(x):\n    s = str(x)\n    return all(c in '47' for c in s)\n\ndef gen_lucky(max_len=10):\n    lst = []\n    for length in range(1, max_len+1):\n        for bits in product('47', repeat=length):\n            lst.append(int(''.join(bits)))\n    return lst\n\ndef count_le(lucky_list, X):\n    if X <= 0:\n        return 0\n    return sum(1 for x in lucky_list if x <= X)\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    # find minimal L such that L! >= k, with L <= n\n    L = 0\n    current = 1\n    while current < k:\n        if L >= n:\n            break\n        L += 1\n        current *= L\n    \n    if current < k:\n        print(-1)\n        return\n    \n    idx = k - 1\n    \n    # build factorial array for L\n    fact_arr = [1] * (L + 1)\n    for i in range(1, L + 1):\n        fact_arr[i] = fact_arr[i-1] * i\n    \n    available = list(range(n - L + 1, n + 1))\n    result = []\n    remaining = idx\n    for pos in range(L, 0, -1):\n        f = fact_arr[pos - 1]\n        index = remaining // f\n        remaining %= f\n        result.append(available.pop(index))\n    \n    lucky_list = gen_lucky(10)\n    \n    # first part: positions 1..(n-L), a_i = i\n    first_limit = n - L\n    count_first = count_le(lucky_list, first_limit)\n    \n    # second part: positions n-L+1..n with values in result\n    count_second = 0\n    start_pos = n - L + 1\n    for offset in range(L):\n        position = start_pos + offset\n        value = result[offset]\n        if is_lucky(position) and is_lucky(value):\n            count_second += 1\n    \n    total = count_first + count_second\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n```",
